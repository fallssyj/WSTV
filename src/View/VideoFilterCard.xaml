<UserControl
    x:Class="WSTV.View.VideoFilterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WSTV.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:PlayChannelViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">


    <Border
        Margin="10"
        Background="{StaticResource BackgroundCardBrush}"
        CornerRadius="15">
        <ScrollViewer Margin="0,4,5,4" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,10,16,14">
                <!--  ── 视频处理器 ────────────────────────────────────────────  -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="视频处理器" />
                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        SelectedValue="{Binding VideoFilter.VideoProcessor, Mode=TwoWay}"
                        SelectedValuePath="Content">
                        <ComboBoxItem Content="Flyleaf" />
                        <ComboBoxItem Content="D3D11" />
                        <ComboBoxItem Content="Auto" />
                    </ComboBox>
                </Grid>

                <!--  ── HDR 色调映射 ─────────────────────────────────────────  -->
                <Grid Margin="0,10,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="HDR 色调映射" />
                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        SelectedValue="{Binding VideoFilter.HdrToSdrMethod, Mode=TwoWay}"
                        SelectedValuePath="Content">
                        <ComboBoxItem Content="Hable" />
                        <ComboBoxItem Content="Reinhard" />
                        <ComboBoxItem Content="Aces" />
                    </ComboBox>

                </Grid>



                <Separator Margin="0,8,0,8" Opacity="0.15" />

                <!--  ── SDR 屏幕亮度 ────────────────────────────────────────────  -->
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="SDR 屏幕亮度" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="0" />
                    <Slider
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="1000"
                        Minimum="0"
                        Style="{StaticResource VolumeSliderStyle}"
                        TickFrequency="25"
                        Value="{Binding VideoFilter.SdrDisplayNitsCustom, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding VideoFilter.SdrNitsRightLabel}" />
                </Grid>

                <!--  ── 亮度 ──────────────────────────────────────────────────────────────  -->
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="亮度" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="-100" />
                    <Slider
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="-100"
                        Style="{StaticResource VolumeSliderStyle}"
                        Value="{Binding VideoFilter.Brightness, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding VideoFilter.Brightness, StringFormat='100 ( {0} )'}" />
                </Grid>

                <!--  ── 对比度 ──────────────────────────────────────────────────────────────  -->
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="对比度" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="-100" />
                    <Slider
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="-100"
                        Style="{StaticResource VolumeSliderStyle}"
                        Value="{Binding VideoFilter.Contrast, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding VideoFilter.Contrast, StringFormat='100 ( {0} )'}" />
                </Grid>

                <!--  ── 色调 ────────────────────────────────────────────────────────────────  -->
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="色调" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="-180" />
                    <Slider
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Maximum="180"
                        Minimum="-180"
                        Style="{StaticResource VolumeSliderStyle}"
                        Value="{Binding VideoFilter.Hue, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding VideoFilter.Hue, StringFormat='180 ( {0} )'}" />
                </Grid>

                <!--  ── 饱和度 ─────────────────────────────────────────────────────────────  -->
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="饱和度" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="-100" />
                    <Slider
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="-100"
                        Style="{StaticResource VolumeSliderStyle}"
                        Value="{Binding VideoFilter.Saturation, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding VideoFilter.Saturation, StringFormat='100 ( {0} )'}" />
                </Grid>

                <Separator Margin="0,10,0,10" Opacity="0.15" />

                <!--  ── 额外选项 ─────────────────────────────────────────  -->
                <StackPanel Margin="0,4,0,6">
                    <CheckBox
                        Margin="0,5"
                        Content="同步 VP 滤镜值"
                        IsChecked="{Binding VideoFilter.SyncVPFilters, Mode=TwoWay}" />
                    <CheckBox
                        Margin="0,5"
                        Content="强制使用 SwsScale"
                        IsChecked="{Binding VideoFilter.SwsForce, Mode=TwoWay}" />
                    <CheckBox
                        Margin="0,5"
                        Content="启用超分（D3D11）"
                        IsChecked="{Binding VideoFilter.SuperResolution, Mode=TwoWay}" />
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="最大输出帧率" />
                        <Slider
                            Grid.Column="1"
                            Maximum="240"
                            Minimum="15"
                            Style="{StaticResource VolumeSliderStyle}"
                            Value="{Binding VideoFilter.MaxOutputFps, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{Binding VideoFilter.MaxOutputFps, StringFormat='0 ( {0} )'}" />
                    </Grid>
                    <CheckBox
                        Margin="0,5"
                        Content="使用 2D 绘图"
                        IsChecked="{Binding VideoFilter.Use2DGraphics, Mode=TwoWay}" />
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="GPU Adapter" />
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{Binding VideoFilter.GpuAdapterOptions}"
                            SelectedItem="{Binding VideoFilter.SelectedGpuAdapter, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!--  ── 操作按钮 ─────────────────────────────────────────  -->
                <StackPanel
                    Margin="0,20"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="6,0"
                        Command="{Binding VideoFilter.SaveCommand}"
                        Content="保存"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Margin="6,0"
                        Command="{Binding VideoFilter.ApplyCommand}"
                        Content="应用"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Command="{Binding VideoFilter.ResetCommand}"
                        Content="重置"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Margin="6,0"
                        Command="{Binding VideoFilter.CancelCommand}"
                        Content="取消"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
