<UserControl
    x:Class="WSTV.View.EpgPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WSTV.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  节目列表 / 加载中 / 无数据提示  -->
        <Grid Grid.Row="0">
            <!--  加载中  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEpgLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar
                    Width="120"
                    Height="4"
                    IsIndeterminate="True"
                    Style="{StaticResource {x:Type ProgressBar}}" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="正在加载节目单…" />
            </StackPanel>

            <!--  无 EPG 数据  -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEpgLoading}" Value="False" />
                                    <Condition Binding="{Binding HasNoEpg}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="暂无节目单数据" />
                <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource AccentPrimaryBrush}"
                    Text="请在「设置」中添加 EPG 订阅源" />
            </StackPanel>

            <!--  EPG 节目列表  -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasEpg, Converter={StaticResource BoolToVis}}">
                <ItemsControl converters:ScrollToItemBehavior.ScrollToItem="{Binding NowPlayingProgram}" ItemsSource="{Binding EpgPrograms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,0.5">
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  时间  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding TimeText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!--  标题 + 时长  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="8,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            Text="{Binding DurationText}" />
                                    </StackPanel>

                                    <!--  状态标签  -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="6,5"
                                        VerticalAlignment="Center"
                                        CornerRadius="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!--  底部：正在播放  -->
        <Border
            Grid.Row="1"
            Padding="14,10"
            Background="{StaticResource BackgroundSecondaryBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding HasEpg, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource AccentPrimaryBrush}"
                    Text="正在播放：" />
                <TextBlock
                    MaxWidth="280"
                    FontSize="12"
                    Foreground="{StaticResource AccentPrimaryBrush}"
                    Text="{Binding NowPlayingProgram.Title, FallbackValue='暂无节目信息'}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
