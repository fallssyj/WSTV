<UserControl
    x:Class="WSTV.View.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WSTV.ViewModels"
    d:DataContext="{d:DesignInstance vm:AboutViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="500"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题区域  -->
        <Grid Grid.Row="0" Margin="0,5">
            <Button
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding GoBackCommand}"
                Content="{StaticResource ChevronLeft}"
                Style="{StaticResource CircularIconButton}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="关于" />
        </Grid>

        <!--  内容区域  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,40" Orientation="Vertical">

                <!--  应用图标 + 名称  -->
                <StackPanel
                    Margin="0,24,0,32"
                    HorizontalAlignment="Center"
                    Orientation="Vertical">
                    <Viewbox
                        Width="72"
                        Height="72"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center">
                        <Image Source="{StaticResource LogoIcon}" />

                    </Viewbox>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="WSTV" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="基于 WPF 的 M3U 播放客户端" />
                </StackPanel>

                <!--  信息列表  -->
                <Border
                    Padding="16,4"
                    Background="{StaticResource BackgroundSecondaryBrush}"
                    CornerRadius="8">
                    <StackPanel Orientation="Vertical">

                        <!--  版本  -->
                        <Border
                            Padding="0,12,0,12"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="版本" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding AppVersion}" />
                            </Grid>
                        </Border>

                        <!--  开源协议  -->
                        <Border
                            Padding="0,12,0,12"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="开源协议" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="MIT License" />
                            </Grid>
                        </Border>

                        <!--  运行时  -->
                        <Border
                            Padding="0,12,0,12"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="运行时" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text=".NET 8.0 (WPF)" />
                            </Grid>
                        </Border>

                        <!--  媒体引擎  -->
                        <Border
                            Padding="0,12,0,12"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="媒体引擎" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="FFmpeg 8.0" />
                            </Grid>
                        </Border>

                        <!--  CommunityToolkit.Mvvm  -->
                        <Border
                            Padding="0,12,0,12"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="CommunityToolkit.Mvvm" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="8.4.0" />
                            </Grid>
                        </Border>

                        <!--  Flyleaf.FFmpeg.Bindings  -->
                        <Border
                            Padding="0,12,0,12"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="Flyleaf.FFmpeg.Bindings" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="8.0.1" />
                            </Grid>
                        </Border>

                        <!--  FlyleafLib  -->
                        <Border
                            Padding="0,12,0,12"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="FlyleafLib" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="3.10.2" />
                            </Grid>
                        </Border>

                        <!--  Microsoft.Xaml.Behaviors.Wpf  -->
                        <Border
                            Padding="0,12,0,12"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="Microsoft.Xaml.Behaviors.Wpf" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="1.1.142" />
                            </Grid>
                        </Border>

                        <!--  作者  -->
                        <Border Padding="0,12,0,12">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="缝合怪" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="syj" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
