<UserControl
    x:Class="WSTV.View.PlayChannelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WSTV.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
    xmlns:local="clr-namespace:WSTV.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="500"
    mc:Ignorable="d">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1.3*" />
            </Grid.RowDefinitions>
            <!--  标题区域  -->
            <Grid Grid.Row="0">

                <Grid Margin="0,5">
                    <Button
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding GoBackCommand}"
                        Content="{StaticResource ChevronLeft}"
                        Style="{StaticResource CircularIconButton}" />
                    <Grid MaxWidth="260" HorizontalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                            <!--  频道名称  -->
                            <TextBlock
                                FontSize="20"
                                Text="{Binding CurrentChannel.DisplayName}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  频道组 + 频道图标  -->
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,2,5,0"
                                    HorizontalAlignment="Left"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{Binding CurrentChannel.GroupTitle}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentChannel.GroupTitle}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!--  频道图标（TvgLogo 为空时折叠）  -->
                                <Image
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Right"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding CurrentChannel.LogoImage}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentChannel.TvgLogo}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border
                        Width="110"
                        Height="40"
                        Margin="0,0,10,0"
                        Padding="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource BackgroundSecondaryBrush}"
                        CornerRadius="20">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ToggleFavoriteCommand}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource IconButtonNoRadius}" TargetType="Button">
                                        <Setter Property="Content" Value="{StaticResource Heart3Line}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentChannel.Favorite}" Value="True">
                                                <Setter Property="Content" Value="{StaticResource Heart3Fill}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Command="{Binding ToggleVideoFilterCommand}"
                                Content="{StaticResource VideoOn}"
                                Style="{StaticResource IconButtonNoRadius}" />
                            <Button
                                Command="{Binding ToggleInfoCommand}"
                                Content="{StaticResource CircleInfo}"
                                Style="{StaticResource IconButtonNoRadius}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <!--  视频区域  -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <fl:FlyleafHost
                    ActivityTimeout="3500"
                    DetachedDragMove="Both"
                    DetachedNoOwner="True"
                    DetachedResize="Overlay"
                    DetachedTopMost="True"
                    KeyBindings="Surface"
                    OpenOnDrop="Both"
                    Player="{Binding Player}"
                    ToggleFullScreenOnDoubleClick="Both">
                    <Grid>
                        <Grid.Resources>
                            <Storyboard x:Key="fadeIn" Timeline.DesiredFrameRate="10">
                                <DoubleAnimation
                                    AutoReverse="False"
                                    Storyboard.TargetProperty="Opacity"
                                    To="1"
                                    Duration="0:0:0.5" />
                            </Storyboard>
                            <Storyboard x:Key="fadeOut" Timeline.DesiredFrameRate="10">
                                <DoubleAnimation
                                    AutoReverse="False"
                                    Storyboard.TargetProperty="Opacity"
                                    To="0"
                                    Duration="0:0:2.0" />
                            </Storyboard>
                        </Grid.Resources>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Player.Activity.Mode}" Value="Idle">
                                        <DataTrigger.EnterActions>
                                            <RemoveStoryboard BeginStoryboardName="fadeInN" />
                                            <BeginStoryboard x:Name="fadeOutN" Storyboard="{StaticResource fadeOut}" />
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Player.Activity.Mode}" Value="Active">
                                        <DataTrigger.EnterActions>
                                            <RemoveStoryboard BeginStoryboardName="fadeInN" />
                                            <BeginStoryboard x:Name="fadeOutN2" Storyboard="{StaticResource fadeOut}" />
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Player.Activity.Mode, FallbackValue=FullActive, TargetNullValue=FullActive}" Value="FullActive">
                                        <DataTrigger.EnterActions>
                                            <RemoveStoryboard BeginStoryboardName="fadeOutN" />
                                            <RemoveStoryboard BeginStoryboardName="fadeOutN2" />
                                            <BeginStoryboard x:Name="fadeInN" Storyboard="{StaticResource fadeIn}" />
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border VerticalAlignment="Top">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.5" Color="{Binding Player.Config.Video.BackColor}" />
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPiP}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding DataContext.CurrentChannel.DisplayName}" />
                                <Button
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    Command="{Binding DataContext.TogglePipCommand}"
                                    Content="{StaticResource close}"
                                    Style="{StaticResource IconButton}" />
                            </Grid>
                        </Border>
                        <!--  Error Message  -->
                        <TextBox
                            Margin="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Text="Error Message"
                            BorderThickness="0"
                            FontSize="13"
                            IsReadOnly="True"
                            TextWrapping="Wrap">
                            <TextBox.Text>
                                <MultiBinding StringFormat="Error Message:{0}&#x0a;PlayPath:{1}">
                                    <Binding Path="Player.LastError" />
                                    <Binding Path="Player.Playlist.Url" />
                                </MultiBinding>
                            </TextBox.Text>
                            <TextBox.Background>
                                <SolidColorBrush Opacity="0.15" Color="{Binding Player.Config.Video.BackColor}" />
                            </TextBox.Background>
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                                    <Setter Property="FontFamily" Value="{StaticResource MiSansRegular}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            d:Value="notnull"
                                            Binding="{Binding Player.LastError}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!--  视频控制栏  -->
                        <Border Padding="0,5" VerticalAlignment="Bottom">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.5" Color="{Binding Player.Config.Video.BackColor}" />
                            </Border.Background>
                            <Grid VerticalAlignment="Center">
                                <StackPanel
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="6"
                                        Height="6"
                                        Margin="15,0,0,0"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource StatusErrorBrush}" />

                                    <TextBlock
                                        Margin="6,0"
                                        VerticalAlignment="Center"
                                        Text="Live" />
                                    <!--  暂停播放按钮  -->
                                    <Button Margin="0,0,4,0" Command="{Binding Player.Commands.TogglePlayPause}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                                <Setter Property="Width" Value="32" />
                                                <Setter Property="Height" Value="32" />

                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="Content" Value="{StaticResource Play1}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Player.Status}" Value="Playing">
                                                        <Setter Property="Content" Value="{StaticResource Pause1}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource AccentPrimaryBrush}"
                                        Text="正在播放：" />
                                    <TextBlock
                                        MaxWidth="280"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource AccentPrimaryBrush}"
                                        Text="{Binding DataContext.NowPlayingProgram.Title, FallbackValue='暂无节目信息'}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <!--  静音按钮  -->
                                    <Button Margin="0,0,4,0" Command="{Binding Player.Commands.ToggleMute}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                                <Setter Property="Width" Value="32" />
                                                <Setter Property="Height" Value="32" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="Content" Value="{StaticResource VolumeHigh}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Player.Audio.Mute}" Value="True">
                                                        <Setter Property="Content" Value="{StaticResource VolumeMute}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!--  音量滑块  -->
                                    <Slider
                                        Width="90"
                                        Margin="0,0,8,0"
                                        Maximum="150"
                                        Minimum="0"
                                        Style="{StaticResource VolumeSliderStyle}"
                                        Value="{Binding Player.Audio.Volume}" />

                                    <!--  画中画按钮  -->
                                    <Button Command="{Binding DataContext.TogglePipCommand}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                                <Setter Property="Width" Value="32" />
                                                <Setter Property="Height" Value="32" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="Content" Value="{StaticResource Share1}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsPiP}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!--  全屏按钮  -->
                                    <Button Command="{Binding Player.Commands.ToggleFullScreen}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                                <Setter Property="Width" Value="32" />
                                                <Setter Property="Height" Value="32" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="Content" Value="{StaticResource Maximize2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Player.Host.IsFullScreen}" Value="True">
                                                        <Setter Property="Content" Value="{StaticResource Minimize2}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </fl:FlyleafHost>
            </Grid>
            <!--  功能区域  -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundBaseBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Tab 标签栏  -->
                    <Grid
                        Grid.Row="0"
                        Height="46"
                        Background="{StaticResource BackgroundSecondaryBrush}">
                        <UniformGrid Columns="4">
                            <!--  分类  -->
                            <RadioButton
                                Content="分类"
                                GroupName="TabGroup"
                                IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqConverter}, ConverterParameter=0}"
                                Style="{StaticResource TabRadioButtonStyle}" />
                            <!--  频道  -->
                            <RadioButton
                                Content="频道"
                                GroupName="TabGroup"
                                IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqConverter}, ConverterParameter=1}"
                                Style="{StaticResource TabRadioButtonStyle}" />
                            <!--  节目  -->
                            <RadioButton
                                Content="节目"
                                GroupName="TabGroup"
                                IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqConverter}, ConverterParameter=2}"
                                Style="{StaticResource TabRadioButtonStyle}" />
                            <!--  线路：显示 "N/N 线路"  -->
                            <RadioButton
                                GroupName="TabGroup"
                                IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqConverter}, ConverterParameter=3}"
                                Style="{StaticResource TabRadioButtonStyle}">
                                <TextBlock>
                                    <Run Text="{Binding CurrentChannel.Links.Count, FallbackValue=0, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding CurrentChannel.Links.Count, FallbackValue=0, Mode=OneWay}" /><Run Text=" 线路" />
                                </TextBlock>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>

                    <!--  Tab 内容区  -->
                    <Grid Grid.Row="1">

                        <!--  ① 分类 Tab  -->
                        <ScrollViewer Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqToVisConverter}, ConverterParameter=0}">
                            <ItemsControl ItemsSource="{Binding GroupSummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="0,0,0,0.5"
                                            Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding
                                                    Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    MouseAction="LeftClick" />
                                            </Border.InputBindings>
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource ObjEqToBgBrush}">
                                                    <Binding Path="DataContext.SelectedGroup" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    <Binding />
                                                </MultiBinding>
                                            </Border.Background>
                                            <Grid Margin="16,14">
                                                <TextBlock Text="{Binding Title}">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource ObjEqToFgBrush}">
                                                            <Binding Path="DataContext.SelectedGroup" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            <Binding />
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                                <TextBlock HorizontalAlignment="Right">
                                                    <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" 个频道" />
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource ObjEqToFgBrush}">
                                                            <Binding Path="DataContext.SelectedGroup" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            <Binding />
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!--  ② 频道 Tab  -->
                        <local:ChannelListPanel DataContext="{Binding}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqToVisConverter}, ConverterParameter=1}" />

                        <!--  ③ 节目 Tab（EPG）  -->
                        <local:EpgPanel DataContext="{Binding}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqToVisConverter}, ConverterParameter=2}" />
                        <!--  ④ 线路 Tab  -->
                        <ScrollViewer Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqToVisConverter}, ConverterParameter=3}">
                            <ItemsControl ItemsSource="{Binding IndexedLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="0,0,0,0.5"
                                            Cursor="Hand">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource IntEqToBrushMulti}">
                                                    <Binding Path="DataContext.SelectedLinkIndex" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    <Binding Path="Index" />
                                                </MultiBinding>
                                            </Border.Background>
                                            <Border.InputBindings>
                                                <MouseBinding
                                                    Command="{Binding DataContext.SwitchLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    MouseAction="LeftClick" />
                                            </Border.InputBindings>
                                            <Grid Margin="12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!--  频道 Logo  -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="40"
                                                    Height="40"
                                                    Margin="0,0,10,0"
                                                    Padding="5"
                                                    Background="{StaticResource BackgroundTertiaryBrush}"
                                                    CornerRadius="4">
                                                    <Grid>
                                                        <Image
                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                            Source="{Binding DataContext.CurrentChannel.LogoImage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Stretch="Uniform">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.CurrentChannel.TvgLogo, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <!--  无 Logo 时显示图标  -->
                                                        <Path
                                                            Width="15"
                                                            Height="15"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource Youtube}"
                                                            Fill="{StaticResource TextSecondaryBrush}"
                                                            Stretch="Uniform">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.CurrentChannel.TvgLogo, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </Border>
                                                <!--  序号 + 标题 + URL  -->
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            Margin="0,0,4,0"
                                                            FontWeight="Bold"
                                                            Foreground="{StaticResource AccentPrimaryBrush}">
                                                            <Run Text="#" /><Run Text="{Binding DisplayIndex, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding DataContext.CurrentChannel.DisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        Style="{StaticResource SecondaryTextStyle}"
                                                        Text="{Binding Url}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <!--  正在播放标记  -->
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource AccentPrimaryBrush}"
                                                    Text="正在播放">
                                                    <TextBlock.Visibility>
                                                        <MultiBinding Converter="{StaticResource IntEqToVisMulti}">
                                                            <Binding Path="DataContext.SelectedLinkIndex" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            <Binding Path="Index" />
                                                        </MultiBinding>
                                                    </TextBlock.Visibility>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Border>

            <!--  视频信息  -->
            <local:VideoInfoCard
                Grid.Row="2"
                DataContext="{Binding}"
                Visibility="{Binding IsInfoVisible, Converter={StaticResource BoolToVis}}" />

            <!--  视频滤镜调节  -->
            <local:VideoFilterCard
                Grid.Row="2"
                DataContext="{Binding}"
                Visibility="{Binding IsVideoFilterVisible, Converter={StaticResource BoolToVis}}" />
        </Grid>

    </Grid>
</UserControl>
