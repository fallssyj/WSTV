<UserControl
    x:Class="WSTV.View.ConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WSTV.ViewModels"
    d:DataContext="{d:DesignInstance vm:ConfigViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Border>
        <Grid>
            <!--  第一层：标题 + 订阅列表  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  标题栏  -->
                <Grid Grid.Row="0" Margin="16,16,16,10">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="28"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="管理订阅" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding ShowAddPanelCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                        <Grid>
                            <Path
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Left"
                                Data="{StaticResource AddLink}"
                                Fill="{StaticResource TextPrimaryBrush}"
                                Stretch="Uniform" />
                            <TextBlock
                                Margin="20,0"
                                FontSize="14"
                                Text="添加订阅" />
                        </Grid>
                    </Button>
                </Grid>

                <!--  订阅列表  -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="SubList"
                        Margin="0,0,0,200"
                        ItemsSource="{Binding Subscriptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="12,3,12,3"
                                    Background="{StaticResource BackgroundSecondaryBrush}"
                                    CornerRadius="8">
                                    <Grid Margin="14,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  激活状态圆点  -->
                                        <Ellipse
                                            Grid.Column="0"
                                            Width="8"
                                            Height="8"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource BorderSubtleBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource StatusSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!--  名称 + 频道数 + 更新时间  -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{StaticResource TextTertiaryBrush}"
                                                    Text="{Binding Count, StringFormat={}{0} 个频道}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    FontSize="12"
                                                    Foreground="{StaticResource TextTertiaryBrush}"
                                                    Text="{Binding UpdateTimeDisplay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  操作按钮组  -->
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Button
                                                Command="{Binding DataContext.ActivateSubscriptionCommand, ElementName=SubList}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="激活" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Text" Value="已激活" />
                                                                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button
                                                Command="{Binding DataContext.RefreshSubscriptionCommand, ElementName=SubList}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Style="{StaticResource ActionButtonStyle}">
                                                <TextBlock Text="刷新" />
                                            </Button>
                                            <Button
                                                Command="{Binding DataContext.EditSubscriptionCommand, ElementName=SubList}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Style="{StaticResource ActionButtonStyle}">
                                                <TextBlock Text="编辑" />
                                            </Button>
                                            <Button
                                                Command="{Binding DataContext.DeleteSubscriptionCommand, ElementName=SubList}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource StatusErrorBrush}"
                                                Style="{StaticResource ActionButtonStyle}">
                                                <TextBlock Text="删除" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!--  第二层：添加订阅 遮罩弹窗  -->
            <Grid Visibility="{Binding IsAddPanelVisible, Converter={StaticResource BoolToVis}}">
                <!--  半透明遮罩，点击关闭  -->
                <Border Background="#80000000">
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding HideAddPanelCommand}" Gesture="LeftClick" />
                    </Border.InputBindings>
                </Border>
                <!--  弹窗卡片  -->
                <Border
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BackgroundSecondaryBrush}"
                    CornerRadius="14">
                    <StackPanel Margin="24,20">
                        <!--  标题行  -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="添加订阅" />
                            <Button
                                Padding="6,4"
                                HorizontalAlignment="Right"
                                Command="{Binding HideAddPanelCommand}"
                                Style="{StaticResource ActionButtonStyle}">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="✕" />
                            </Button>
                        </Grid>

                        <!--  订阅名称  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="订阅名称" />
                        <TextBox
                            Margin="0,0,0,14"
                            Padding="0,10"
                            Tag="为该订阅取个名字..."
                            Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  来源类型  -->
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="来源类型" />
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <RadioButton
                                Content="网络地址"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                GroupName="AddSource"
                                IsChecked="{Binding IsUrlSource}" />
                            <RadioButton
                                Margin="20,0,0,0"
                                Content="本地文件"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                GroupName="AddSource"
                                IsChecked="{Binding IsLocalFileSource}" />
                        </StackPanel>

                        <!--  URL 输入（网络地址时显示）  -->
                        <StackPanel Margin="0,0,0,14" Visibility="{Binding IsUrlSource, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="订阅地址" />
                            <TextBox
                                Padding="0,10"
                                Tag="https://example.com/playlist.m3u"
                                Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  本地文件（本地文件时显示）  -->
                        <StackPanel Margin="0,0,0,14" Visibility="{Binding IsLocalFileSource, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="文件路径" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Padding="0,10"
                                    IsReadOnly="True"
                                    Tag="选择本地 M3U 文件..."
                                    Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding BrowseLocalFileCommand}"
                                    Style="{StaticResource ActionButtonStyle}">
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="浏览..." />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!--  错误提示  -->
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="12"
                            Foreground="{StaticResource StatusErrorBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />

                        <!--  确认 / 取消  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                Padding="0,10"
                                HorizontalContentAlignment="Center"
                                Command="{Binding HideAddPanelCommand}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Style="{StaticResource ActionButtonStyle}">
                                <TextBlock Text="取消" />
                            </Button>
                            <Button
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="0,10"
                                HorizontalContentAlignment="Center"
                                Command="{Binding AddSubscriptionCommand}"
                                Style="{StaticResource PrimaryButtonStyle}">
                                <TextBlock Text="添加" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  第三层：编辑订阅 遮罩弹窗  -->
            <Grid Visibility="{Binding IsEditPanelVisible, Converter={StaticResource BoolToVis}}">
                <!--  半透明遮罩，点击关闭  -->
                <Border Background="#80000000">
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding CancelEditCommand}" Gesture="LeftClick" />
                    </Border.InputBindings>
                </Border>
                <!--  弹窗卡片  -->
                <Border
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BackgroundSecondaryBrush}"
                    CornerRadius="14">
                    <StackPanel Margin="24,20">
                        <!--  标题行  -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="编辑订阅" />
                            <Button
                                Padding="6,4"
                                HorizontalAlignment="Right"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource ActionButtonStyle}">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="✕" />
                            </Button>
                        </Grid>

                        <!--  订阅名称  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="订阅名称" />
                        <TextBox
                            Margin="0,0,0,14"
                            Padding="0,10"
                            Tag="订阅名称..."
                            Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  来源类型  -->
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="来源类型" />
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <RadioButton
                                Content="网络地址"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                GroupName="EditSource"
                                IsChecked="{Binding EditIsUrlSource}" />
                            <RadioButton
                                Margin="20,0,0,0"
                                Content="本地文件"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                GroupName="EditSource"
                                IsChecked="{Binding EditIsLocalFileSource}" />
                        </StackPanel>

                        <!--  URL 输入（网络地址时显示）  -->
                        <StackPanel Margin="0,0,0,14" Visibility="{Binding EditIsUrlSource, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="订阅地址" />
                            <TextBox
                                Padding="0,10"
                                Tag="https://example.com/playlist.m3u"
                                Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  本地文件（本地文件时显示）  -->
                        <StackPanel Margin="0,0,0,14" Visibility="{Binding EditIsLocalFileSource, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="文件路径" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Padding="0,10"
                                    IsReadOnly="True"
                                    Tag="选择本地 M3U 文件..."
                                    Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding BrowseEditFileCommand}"
                                    Style="{StaticResource ActionButtonStyle}">
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="浏览..." />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!--  确认 / 取消  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                Padding="0,10"
                                HorizontalContentAlignment="Center"
                                Command="{Binding CancelEditCommand}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Style="{StaticResource ActionButtonStyle}">
                                <TextBlock Text="取消" />
                            </Button>
                            <Button
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="0,10"
                                HorizontalContentAlignment="Center"
                                Command="{Binding SaveEditCommand}"
                                Style="{StaticResource PrimaryButtonStyle}">
                                <TextBlock Text="保存" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>


</UserControl>
