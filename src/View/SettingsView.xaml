<UserControl
    x:Class="WSTV.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WSTV.ViewModels"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="500"
    mc:Ignorable="d">

    <Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  页面标题  -->
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,10"
                FontSize="28"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="设置" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5,0,5,200" Orientation="Vertical">
                    <!--  EPG设置  -->
                    <Border
                        Margin="0,16,0,0"
                        Padding="12"
                        Background="{StaticResource BackgroundSecondaryBrush}"
                        CornerRadius="8">
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--  EPG 区域标题 + "全部刷新" 按钮  -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="EPG 节目单" />
                                <Button HorizontalAlignment="Right" Command="{Binding RefreshAllEpgCommand}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRefreshingAll}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,6,0">
                                            <Path
                                                Data="{StaticResource Refresh}"
                                                Fill="{StaticResource TextPrimaryBrush}"
                                                Stretch="Uniform" />
                                        </Viewbox>
                                        <TextBlock Text="全部刷新" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!--  添加新订阅  -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Tag="输入 EPG 地址（.xml 或 .xml.gz）"
                                    Text="{Binding NewEpgUrl, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddEpgCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding AddEpgCommand}"
                                    Style="{StaticResource ActionButtonStyle}">
                                    <TextBlock Text="添加" />
                                </Button>
                            </Grid>

                            <!--  EPG 订阅列表  -->
                            <ScrollViewer
                                Grid.Row="2"
                                MaxHeight="200"
                                Margin="0,8,0,0"
                                Padding="0,0,4,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EpgSubscriptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="12,10"
                                                Background="{StaticResource BackgroundSecondaryBrush}"
                                                CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  URL + 时间 / 错误  -->
                                                    <StackPanel
                                                        Grid.Column="0"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="13"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            Text="{Binding Url}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Text="{Binding UpdateTimeDisplay}" />
                                                            <TextBlock
                                                                Margin="6,0,0,0"
                                                                FontSize="11"
                                                                Foreground="{StaticResource AccentPrimaryBrush}"
                                                                Text="更新中…"
                                                                Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock
                                                                Margin="6,0,0,0"
                                                                FontSize="11"
                                                                Foreground="#E86464"
                                                                Text="{Binding LastError}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!--  单条刷新  -->
                                                    <Button
                                                        Grid.Column="1"
                                                        Command="{Binding DataContext.RefreshEpgCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Style="{StaticResource ActionButtonStyle}">
                                                        <TextBlock Text="刷新" />
                                                    </Button>
                                                    <!--  删除  -->
                                                    <Button
                                                        Grid.Column="2"
                                                        Command="{Binding DataContext.RemoveEpgCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Style="{StaticResource ActionButtonStyle}">
                                                        <TextBlock Text="删除" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                    </Border>

                    <!--  清空缓存设置：删除配置 / EPG / Logo  -->
                    <Border
                        Margin="0,16,0,0"
                        Padding="12"
                        Background="{StaticResource BackgroundSecondaryBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Margin="0,5"
                                FontSize="16"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="清空缓存" />
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,5"
                                Orientation="Vertical">
                                <CheckBox
                                    Margin="0,5"
                                    Content="删除整个配置（含订阅缓存与设置）"
                                    IsChecked="{Binding DeleteConfig, Mode=TwoWay}" />
                                <CheckBox
                                    Margin="0,5"
                                    Content="删除 EPG 缓存"
                                    IsChecked="{Binding DeleteEpg, Mode=TwoWay}" />
                                <CheckBox
                                    Margin="0,5"
                                    Content="删除 Channel Logo 缓存"
                                    IsChecked="{Binding DeleteLogos, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="2"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Width="120"
                                    Command="{Binding OpenCacheDirCommand}"
                                    Content="打开缓存目录"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Width="120"
                                    Margin="5,0"
                                    Command="{Binding ClearCachesCommand}"
                                    Content="清空所选缓存"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  性能设置  -->
                    <Border
                        Margin="0,16,0,0"
                        Padding="12"
                        Background="{StaticResource BackgroundSecondaryBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                FontSize="16"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="性能设置" />
                            <StackPanel Grid.Row="1" Orientation="Vertical">
                                <StackPanel Margin="0,4" Orientation="Horizontal">
                                    <TextBlock
                                        Width="160"
                                        VerticalAlignment="Center"
                                        Text="Logo LRU 容量" />
                                    <TextBox Width="60" Text="{Binding LogoLruCapacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,4" Orientation="Horizontal">
                                    <TextBlock
                                        Width="160"
                                        VerticalAlignment="Center"
                                        Text="Logo 并发下载数" />
                                    <TextBox Width="60" Text="{Binding LogoDownloadConcurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,4" Orientation="Horizontal">
                                    <TextBlock
                                        Width="160"
                                        VerticalAlignment="Center"
                                        Text="Logo 解码宽度 (px)" />
                                    <TextBox Width="60" Text="{Binding LogoDecodePixelWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                Grid.Row="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <Button
                                    Width="120"
                                    Command="{Binding SavePerformanceSettingsCommand}"
                                    Content="保存"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  关于  -->
                    <Border
                        Margin="0,16,0,0"
                        Background="{StaticResource BackgroundSecondaryBrush}"
                        CornerRadius="8">
                        <Button
                            Padding="10,14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding GoToAboutCommand}"
                            Style="{StaticResource RowButtonStyle}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Viewbox
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,10,0">
                                        <Path
                                            Data="{StaticResource CircleInfo}"
                                            Fill="{StaticResource AccentPrimaryBrush}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="关于" />
                                </StackPanel>
                                <Path
                                    Width="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Data="M 0,0 L 6,5 L 0,10"
                                    Stroke="{StaticResource TextSecondaryBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1.5" />
                            </Grid>
                        </Button>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!--  全局 Toast 状态条（悬浮在底部，有内容时自动显示）  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,100"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Panel.ZIndex="99"
                Background="{StaticResource BackgroundTertiaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0.5"
                CornerRadius="20"
                IsHitTestVisible="False"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    FontSize="13"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding StatusMessage}" />
            </Border>

        </Grid>
    </Border>

</UserControl>
