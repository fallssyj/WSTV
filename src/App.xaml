<Application
    x:Class="WSTV.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WSTV.Converters"
    xmlns:local="clr-namespace:WSTV"
    xmlns:views="clr-namespace:WSTV.View"
    xmlns:vm="clr-namespace:WSTV.ViewModels"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Fonts.xaml" />
                <ResourceDictionary Source="Assets/icons/icons.xaml" />
                <ResourceDictionary Source="Styles/ScrollBar.xaml" />
                <ResourceDictionary Source="Styles/TextBox.xaml" />
                <ResourceDictionary Source="Styles/TextBlockStyles.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
                <ResourceDictionary Source="Styles/Button.xaml" />
                <ResourceDictionary Source="Styles/CheckBox.xaml" />
                <ResourceDictionary Source="Styles/Slider.xaml" />
                <ResourceDictionary Source="Styles/ComboBox.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:WidthToColumnsConverter x:Key="WidthToColumns" />
            <converters:IntEqualityConverter x:Key="EqConverter" />
            <converters:IntEqualityToVisibilityConverter x:Key="EqToVisConverter" />
            <converters:IntEqualityToVisibilityMultiConverter x:Key="IntEqToVisMulti" />
            <converters:IntEqualityToBrushMultiConverter x:Key="IntEqToBrushMulti" />
            <converters:ObjectEqualityMultiConverter x:Key="ObjEqMulti" />
            <!--  选中行背景高亮  -->
            <converters:ObjectEqualityMultiConverter
                x:Key="ObjEqToBgBrush"
                DefaultBrush="Transparent"
                MatchBrush="{StaticResource BackgroundSelectedBrush}" />
            <!--  选中项前景高亮（粉色）  -->
            <converters:ObjectEqualityMultiConverter
                x:Key="ObjEqToFgBrush"
                DefaultBrush="{StaticResource TextPrimaryBrush}"
                MatchBrush="{StaticResource AccentPrimaryBrush}" />

            <!--  ViewModel → View 自动映射，ContentControl 会根据 CurrentPage 类型选择对应 DataTemplate  -->
            <DataTemplate DataType="{x:Type vm:ChannelsViewModel}">
                <views:ChannelsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
                <views:FavoritesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
                <views:ConfigView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlayChannelViewModel}">
                <views:PlayChannelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>


        </ResourceDictionary>
    </Application.Resources>
</Application>
