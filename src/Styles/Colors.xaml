<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ===================== 背景层 =====================  -->
    <!--  最底层背景：窗口/主面板背景  -->
    <Color x:Key="BackgroundDeepColor">#FF0F0F0F</Color>
    <!--  基础背景：内容区、列表底色  -->
    <Color x:Key="BackgroundBaseColor">#FF1A1A1A</Color>
    <!--  次级背景：卡片、侧边栏、弹出层  -->
    <Color x:Key="BackgroundSecondaryColor">#FF242424</Color>
    <!--  三级背景：输入框、悬浮菜单  -->
    <Color x:Key="BackgroundTertiaryColor">#FF2E2E2E</Color>
    <!--  高亮背景：鼠标悬停  -->
    <Color x:Key="BackgroundHoverColor">#FF383838</Color>
    <!--  选中背景：列表项选中状态  -->
    <Color x:Key="BackgroundSelectedColor">#FF404040</Color>
    <!--  信息面板背景：iOS 风格深色卡片  -->
    <Color x:Key="BackgroundCardColor">#FF1C1C1E</Color>

    <!--  ===================== 表面/边框 =====================  -->
    <!--  分割线、细边框  -->
    <Color x:Key="BorderSubtleColor">#FF333333</Color>
    <!--  普通边框：控件轮廓  -->
    <Color x:Key="BorderDefaultColor">#FF484848</Color>
    <!--  强调边框：聚焦状态  -->
    <Color x:Key="BorderFocusColor">#FF686868</Color>

    <!--  ===================== 文字 =====================  -->
    <!--  主要文字：标题、正文  -->
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <!--  次要文字：副标题、描述  -->
    <Color x:Key="TextSecondaryColor">#FFB0B0B0</Color>
    <!--  禁用文字：不可交互内容  -->
    <Color x:Key="TextDisabledColor">#FF606060</Color>
    <!--  三级文字：时间戳、次要元数据  -->
    <Color x:Key="TextTertiaryColor">#FF787878</Color>
    <!--  占位文字：输入框 placeholder  -->
    <Color x:Key="TextPlaceholderColor">#FF505050</Color>
    <!--  反色文字：用于彩色按钮上的文字  -->
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <!--  ===================== 主题强调色 =====================  -->
    <!--  主强调色：按钮、链接、进度条  -->
    <Color x:Key="AccentPrimaryColor">#ff4062</Color>
    <!--  主强调色悬停  -->
    <Color x:Key="AccentPrimaryHoverColor">#292929</Color>
    <!--  主强调色按下  -->
    <Color x:Key="AccentPrimaryPressedColor">#292929</Color>
    <!--  主强调色（低透明度）：选中背景填充  -->
    <Color x:Key="AccentPrimarySubtleColor">#284D9EF5</Color>

    <!--  ===================== 功能色 =====================  -->
    <!--  成功：操作成功、已连接  -->
    <Color x:Key="StatusSuccessColor">#FF4CAF50</Color>
    <!--  警告：加载缓慢、提示  -->
    <Color x:Key="StatusWarningColor">#FFFFC107</Color>
    <!--  错误：播放失败、异常  -->
    <Color x:Key="StatusErrorColor">#FFF44336</Color>
    <!--  信息：通用提示  -->
    <Color x:Key="StatusInfoColor">#FF2196F3</Color>

    <!--  ===================== 遮罩与阴影 =====================  -->
    <!--  模态遮罩：弹窗背景遮罩  -->
    <Color x:Key="OverlayMaskColor">#99000000</Color>
    <!--  阴影色：卡片、弹出层投影  -->
    <Color x:Key="ShadowColor">#CC000000</Color>

    <!--  ===================== SolidColorBrush 快捷刷 =====================  -->
    <SolidColorBrush x:Key="BackgroundDeepBrush" Color="{StaticResource BackgroundDeepColor}" />
    <SolidColorBrush x:Key="BackgroundBaseBrush" Color="{StaticResource BackgroundBaseColor}" />
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiaryColor}" />
    <SolidColorBrush x:Key="BackgroundHoverBrush" Color="{StaticResource BackgroundHoverColor}" />
    <SolidColorBrush x:Key="BackgroundSelectedBrush" Color="{StaticResource BackgroundSelectedColor}" />
    <SolidColorBrush x:Key="BackgroundCardBrush" Color="{StaticResource BackgroundCardColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="{StaticResource TextPlaceholderColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{StaticResource AccentPrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentPrimarySubtleBrush" Color="{StaticResource AccentPrimarySubtleColor}" />

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />

    <SolidColorBrush x:Key="OverlayMaskBrush" Color="{StaticResource OverlayMaskColor}" />

</ResourceDictionary>
